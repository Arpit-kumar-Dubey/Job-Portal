<!DOCTYPE html>
<html>
<head>
    <title>View Jobs</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/candidate/view-jobs">View Jobs</a></li>
                <li><a href="/candidate/applied-jobs">Applied Jobs</a></li>
            </ul>
        </div>
    </nav>
    <div class="container">
        <div class="page-header">
            <h1>Available Jobs</h1>
            <p>Browse and apply for exciting job opportunities</p>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Job ID</th>
                        <th>Title</th>
                        <th>Company</th>
                        <th>Location</th>
                        <th>Description</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Software Engineer</td>
                        <td>ABC Corp</td>
                        <td>New York</td>
                        <td>Develop web applications using latest technologies</td>
                        <td><button class="btn-small btn-view">Apply</button></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Data Analyst</td>
                        <td>XYZ Inc</td>
                        <td>Remote</td>
                        <td>Analyze business data and create insights</td>
                        <td><button class="btn-small btn-view">Apply</button></td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Full Stack Developer</td>
                        <td>Tech Solutions</td>
                        <td>San Francisco</td>
                        <td>Build scalable web and mobile applications</td>
                        <td><button class="btn-small btn-view">Apply</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>