<!DOCTYPE html>
<html>
<head>
    <title>Recruiter Login</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/recruiter/register">Recruiter Register</a></li>
                <li><a href="/recruiter/login">Recruiter Login</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Recruiter Login</h1>
            <p>Sign in to your recruiter account</p>
        </div>

        <div class="form-container">
            <form method="POST" action="/recruiter/login">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>

                <button type="submit">Login</button>
            </form>

            <div class="link-section">
                <p>Don't have an account? <a href="/recruiter/register">Register here</a></p>
            </div>
        </div>
    </div>
</body>
</html>