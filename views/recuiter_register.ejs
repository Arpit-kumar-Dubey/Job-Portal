<!DOCTYPE html>
<html>
<head>
    <title>Recruiter Register</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/recruiter/register">Recruiter Register</a></li>
                <li><a href="/recruiter/login">Recruiter Login</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Register as Recruiter</h1>
            <p>Create your recruiter account to post job opportunities</p>
        </div>

        <div class="form-container">
            <form method="POST" action="/recruiter/register">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter your full name" required>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Create a strong password" required>
                </div>

                <button type="submit">Register</button>
            </form>

            <div class="link-section">
                <p>Already have an account? <a href="/recruiter/login">Login here</a></p>
            </div>
        </div>
    </div>
</body>
</html>