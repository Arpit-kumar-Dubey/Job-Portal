<!DOCTYPE html>
<html>
<head>
    <title>Post Job</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/Rdashboard">Back to Dashboard</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Update Job</h1>
            <p>Share your job opportunity with qualified candidates</p>
        </div>

        <div class="form-container">
            <form method="POST" action="/recruiter/updateJob">
                <input type="hidden" name="id" value="<%= result._id %>">
                <div class="form-group">
                    <label for="title">Job Title</label>
                    <input type="text" id="title" name="title" placeholder="e.g., Senior Software Engineer" value="<%=result.title%>" required>
                </div>

                <div class="form-group">
                    <label for="company">Company Name</label>
                    <input type="text" id="company" name="company" placeholder="Enter company name" value="<%=result.company%>" required>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" placeholder="e.g., New York, NY or Remote" v value="<%=result.location%>" required>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" value="<%=result.description%>" name="description" placeholder="Describe the job responsibilities and requirements"  required></textarea>
                </div>
                  <div class="form-group">
                    <label for="location">Salary</label>
                    <input type="text" value="<%=result.salary%>" id="location" name="salary" placeholder="Enter Salary...." required>
                </div>
               

                <button type="submit">Post Job</button>
            </form>
        </div>
    </div>
</body>
</html>