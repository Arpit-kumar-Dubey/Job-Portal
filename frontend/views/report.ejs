            <h3>2. Recruiter Collection</h3>
            <p>Employers/Recruiters का data store करता है</p>
            <div class="model-schema">
{
  name: String,
  email: String (unique),
  password: String (bcrypt hashed)
}
            </div>
            
            <h3>3. Posted Jobs Collection</h3>
            <p>Recruiters द्वारा post किए गए jobs</p>
            <div class="model-schema">
{
  title: String,                    // Job title
  company: String,
  location: String,
  description: String,              // Job description
  salary: String,
  candidate: String,
  jobId: String,
  status: String,
  RecruiterId: String,              // Email of recruiter
  postedDate: String                // YYYY-MM-DD format
}
            </div>
            
            <h3>4. Applied Jobs Collection</h3>
            <p>Candidates द्वारा apply किए गए jobs</p>
            <div class="model-schema">
{
  title: String,
  company: String,
  location: String,
  description: String,
  salary: String,
  RecruiterId: String,              // Recruiter की email
  candidate: String,                // Candidate की email
  jobId: String,                    // Job का ID
  status: String,                   // "pending", "Accepted", "Rejected"
  name: String,                     // Candidate का naam
  locationCandidate: String,        // Candidate ka location
