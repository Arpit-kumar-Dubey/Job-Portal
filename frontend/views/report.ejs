            <p>Job seekers का user data store करता है</p>
            <div class="model-schema">
{
  email: String,
  password: String (bcrypt hashed),
  name: String,
  skills: String,
  degree: String,
  field: String,
  gradYear: String,
  university: String,
  location: String,
  phone: String,
  company: String,          // Current company
  endDate: String,
  expDescription: String,
  jobTitle: String,         // Current job title
  startDate: String
}
