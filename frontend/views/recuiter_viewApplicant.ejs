<!DOCTYPE html>
<html>
<head>
    <title>View Applicants</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/recruiter/view-posted-jobs">Posted Jobs</a></li>
                <li><a href="/Rdashboard">Back</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Job Applicants</h1>
            <p>Review and manage applications for your job postings</p>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                       
                        <th>Job Title</th>
                        <th>Candidate Name</th>
                        <th>Email</th>
                        <th>Application Date</th>
                        <th>Salary</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <%data.forEach(data=>{%>
            <tr>
                <td><%=data.title%></td>
                <td><%=data.name%></td>
                <td><%=data.candidate%></td>
                <td><%=data.appliedAt%></td>
                <td><%=data.salary%></td>
                <td><%=data.status%></td>
                 <td>
                    <form action="/viewCandidate" method="post">
                    <input type="hidden"  name="Email" value="<%=data.candidate%>">
                    <input type="hidden" name="idJob" value="<%=data._id%>">
                  <button class="btn-small btn-view">View</button>
                  </form>
                           
                        </td>
            </tr>
        <%})%>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>