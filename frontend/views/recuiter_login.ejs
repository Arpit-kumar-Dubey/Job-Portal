<!DOCTYPE html>
<html>
<head>
    <title>Recruiter Login</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Job Portal</a>
            <ul class="nav-links">
                <li><a href="/candidate/login">Candidate Login</a></li>
                <li><a href="/recruiter/login">Recruiter Login</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>Recruiter Login</h1>
            <p>Sign in to your recruiter account</p>
        </div>

        <div class="form-container">
            <form method="POST" action="/recruiter/login1">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
                <!-- <div class="form-group">
                  
                </div> -->

                <button type="submit">Login</button>
            </form>

            <div class="link-section">
                <p>Don't have an account? <a href="/recruiter/register">Register here</a></p>
            </div>
        </div>
    </div>
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="#about">About</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms & Conditions</a>
                <a href="#">Contact</a>
                <a href="#">Blog</a>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Job Portal System. All rights reserved. | Built with ❤️ for Developers</p>
            </div>
        </div>
    </footer>
</body>
</html>
